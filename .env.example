# =============================================================================
#  Variáveis de Ambiente — Maison Café (Template White-Label)
#  Copie para .env ou execute "npm run setup" para gerar automaticamente.
# =============================================================================

# development | production | test
NODE_ENV=development

# Endereço e porta HTTP
HOST=0.0.0.0
PORT=3000

# URL pública (links canônicos, sitemap, prévia no WhatsApp/Instagram e
# destino do redirecionamento HTTPS). Obrigatória quando FORCE_HTTPS=true.
# PUBLIC_URL=https://www.croma.cafe

# Caminho do arquivo SQLite (criado automaticamente se não existir)
DATABASE_PATH=./data/cafe.db

# Duração da sessão administrativa em horas (1 a 72)
SESSION_TTL_HOURS=12

# Número de proxies reversos confiáveis à frente da aplicação.
# IMPORTANTE: atrás de Cloudflare, Nginx, Render ou Railway use 1 (ou mais).
# Com 0 atrás de um proxy, todos os visitantes parecem ter o mesmo IP e os
# limites anti-abuso bloqueiam clientes de verdade (o servidor avisa no log).
TRUST_PROXY=0

# Redirecionar HTTP -> HTTPS automaticamente quando atrás de proxy reverso.
# Exige PUBLIC_URL: o redirecionamento sempre vai para esse domínio.
FORCE_HTTPS=false

# Modo demonstração comercial: mostra o painel "Personalizar Demo" e o link do /admin
# na vitrine. Deixe false (padrão) no site real do cliente.
DEMO_MODE=false

# Segredo criptográfico (mín. 32 caracteres) para anonimização HMAC de IPs (LGPD).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IP_HASH_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Nível de log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

