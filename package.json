{
  "name": "maison-cafe-template",
  "version": "1.0.0",
  "description": "Site premium white-label para cafeterias de cafés especiais: vitrine de luxo, menu digital, reservas online com controle de capacidade e painel administrativo seguro.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src --watch-path=config src/server.js",
    "setup": "node scripts/setup.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "build:static": "node scripts/build-static.js",
    "db:backup": "node scripts/backup.js",
    "admin:create": "node scripts/create-admin.js",
    "lgpd:purge": "node scripts/purge-personal-data.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "cafeteria",
    "specialty-coffee",
    "reservas",
    "white-label",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
}
